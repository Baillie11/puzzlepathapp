# PuzzlePath Environment Configuration Template
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# Database Configuration
PP_DB_HOST=localhost
PP_DB_NAME=your_database_name
PP_DB_USER=your_database_user
PP_DB_PASS=your_database_password
PP_DB_SSL=false

# Security Settings
PP_MIN_QUEST_TIME=300
PP_MAX_QUEST_TIME=14400
PP_ALLOWED_API_HOSTS=your-wordpress-site.com,api.stripe.com

# Development Settings (remove in production)
WP_DEBUG=false

# Session Security (optional - defaults are secure)
PP_SESSION_TIMEOUT=3600
PP_MAX_LOGIN_ATTEMPTS=5
PP_RATE_LIMIT_WINDOW=300
